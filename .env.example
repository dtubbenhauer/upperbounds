# Default checkpoint root for run-partitioned experiment artifacts.
UPPERBOUNDS_CHECKPOINT_ROOT=gs://the-unknotters-checkpoints/upperbounds

# Optional overrides. Leave unset for automatic UTC date and unique run id.
UPPERBOUNDS_RUN_DATE=
UPPERBOUNDS_RUN_ID=

# Optional local service-account path. Leave unset when using ADC/gcloud auth.
GOOGLE_APPLICATION_CREDENTIALS=
